# LLM endpoint (default: local Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Embeddings (default: nomic-embed-text via Ollama)
# Use EMBEDDING_BASE_URL (not EMBEDDINGS_BASE_URL) — pydantic-settings maps field names exactly.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768  # adjust to match your model (nomic-embed-text=768, Qwen3-Embedding-8B=4096)

# Neo4j
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6335

# Application
DEFAULT_JURISDICTION=FR

# Légifrance / PISTE API (optional — for seeding French legal corpora)
# Create an account at https://developer.piste.gouv.fr and add the "Légifrance" API
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# LangSmith tracing (optional — leave LANGSMITH_API_KEY blank to disable)
# Sign up at https://smith.langchain.com to get an API key
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aquila-hammurabi